//=============================================================================
// Common.hlsli
//   全シェーダー共通の定数バッファと補助関数。
//   C++ 側の FrameConstants (FrameConstants.h) と配置を一致させること。
//=============================================================================
#ifndef COMMON_HLSLI
#define COMMON_HLSLI

//-----------------------------------------------------------------------------
// CBFrame : 1 フレームごとの定数 (register b0)
//   行列は CPU 側で転置済みなので mul(float4(v,1), Matrix) の形で使う。
//-----------------------------------------------------------------------------
cbuffer CBFrame : register(b0)
{
    float4x4 View;        // ワールド → ビュー
    float4x4 Proj;        // ビュー → クリップ
    float4x4 ViewProj;    // ワールド → クリップ
    float4   CameraPosW;  // xyz: カメラのワールド座標
    float4   LightDirW;   // xyz: ワールド空間の光源方向 (光源へ向かう単位ベクトル)
    float4   LightDirV;   // xyz: ビュー空間の光源方向
    float4   ScreenSize;  // x: 幅, y: 高さ, z: 1/幅, w: 1/高さ
    float4   Params;      // x: 粒子半径, y: 時間, z,w: ぼかし方向
};

//-----------------------------------------------------------------------------
// 関数名 : JetColor
// 概要   : 0～1 の値を「青 → 水色 → 緑 → 黄 → 赤」のグラデーションに変換する
//          (参考動画の速度による着色を再現)
// 引数   : t : 0～1 (0 = 遅い, 1 = 速い)
// 戻り値 : RGB (各 0～1)
//-----------------------------------------------------------------------------
float3 JetColor(float t)
{
    t = saturate(t);
    // 5 個の制御色を等間隔に置き、区間ごとに線形補間する
    const float3 c0 = float3(0.05, 0.05, 0.70);   // 濃い青
    const float3 c1 = float3(0.00, 0.60, 1.00);   // 水色
    const float3 c2 = float3(0.05, 0.95, 0.30);   // 緑
    const float3 c3 = float3(1.00, 0.95, 0.00);   // 黄
    const float3 c4 = float3(1.00, 0.15, 0.00);   // 赤

    // t を 0～4 に伸ばすと、整数部が「どの 2 色の間か」、小数部が「その中での位置」になる
    float s = t * 4.0;
    if (s < 1.0) return lerp(c0, c1, s);        // 濃い青 → 水色
    if (s < 2.0) return lerp(c1, c2, s - 1.0);  // 水色 → 緑
    if (s < 3.0) return lerp(c2, c3, s - 2.0);  // 緑 → 黄
    return lerp(c3, c4, s - 3.0);               // 黄 → 赤
}

//-----------------------------------------------------------------------------
// 構造体 : FullscreenVSOut
// 概要   : フルスクリーン三角形の頂点シェーダー出力 (ぼかし・合成パスで共用)
//-----------------------------------------------------------------------------
struct FullscreenVSOut
{
    float4 posH : SV_POSITION;   // クリップ座標 (ピクセルシェーダーでは画面ピクセル座標になる)
    float2 uv   : TEXCOORD0;     // 0～1 のスクリーン座標 (左上が原点)
};

//-----------------------------------------------------------------------------
// 関数名 : VSFullscreen
// 概要   : 頂点バッファなしで画面全体を覆う 1 枚の三角形を生成する
//          vid=0: (-1, 1), vid=1: (3, 1), vid=2: (-1, -3) → 画面全体を覆う
// 引数   : vid : SV_VertexID (0, 1, 2)
// 戻り値 : FullscreenVSOut
//-----------------------------------------------------------------------------
FullscreenVSOut VSFullscreen(uint vid : SV_VertexID)
{
    FullscreenVSOut o;
    // ビット演算で頂点番号から (0,0), (2,0), (0,2) を作る小技。
    // vid=0 → (0,0)、vid=1 → (2,0)、vid=2 → (0,2)
    float2 uv = float2((vid << 1) & 2, vid & 2);            // (0,0), (2,0), (0,2)
    // uv 0～2 を クリップ座標 -1～3 に変換する。y は画面の上下が逆なので符号を反転。
    // 画面 (-1～1) より大きい三角形になり、はみ出した部分は GPU が切り落とす。
    o.posH = float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
    o.uv = uv;
    return o;
}

#endif // COMMON_HLSLI
