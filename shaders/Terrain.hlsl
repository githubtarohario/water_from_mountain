//=============================================================================
// Terrain.hlsl
//   山の地形を描画するシェーダー。
//   岩肌テクスチャを貼り、平行光源によるランバート拡散反射で陰影を付ける。
//=============================================================================
#include "Common.hlsli"

Texture2D    RockTex    : register(t0);   // 岩肌テクスチャ
SamplerState LinearWrap : register(s0);   // 線形補間・繰り返しサンプラー

//-----------------------------------------------------------------------------
// 頂点シェーダーの入力 (C++ 側の Terrain::Vertex と対応)
//-----------------------------------------------------------------------------
struct VSIn
{
    float3 pos : POSITION;   // ワールド座標
    float3 nrm : NORMAL;     // 法線
    float2 uv  : TEXCOORD0;  // テクスチャ座標
};

//-----------------------------------------------------------------------------
// 頂点シェーダー → ピクセルシェーダー
//-----------------------------------------------------------------------------
struct PSIn
{
    float4 posH : SV_POSITION;   // クリップ座標
    float3 posW : TEXCOORD0;     // ワールド座標
    float3 nrm  : TEXCOORD1;     // 法線 (ワールド空間)
    float2 uv   : TEXCOORD2;     // テクスチャ座標
};

//-----------------------------------------------------------------------------
// 関数名 : VSMain
// 概要   : 頂点をクリップ空間へ変換し、法線と UV をそのまま渡す
//          (地形のワールド行列は単位行列なので変換不要)
// 引数   : i : 頂点データ
// 戻り値 : PSIn
//-----------------------------------------------------------------------------
PSIn VSMain(VSIn i)
{
    PSIn o;
    o.posH = mul(float4(i.pos, 1.0), ViewProj);
    o.posW = i.pos;
    o.nrm  = i.nrm;
    o.uv   = i.uv;
    return o;
}

//-----------------------------------------------------------------------------
// 関数名 : PSMain
// 概要   : テクスチャ色 × (環境光 + 拡散反射) で色を決める。
//          さらにカメラから遠い谷底ほど少し暗くして奥行き感を出す。
// 引数   : i : 補間済み頂点データ
// 戻り値 : 最終色 (RGBA)
//-----------------------------------------------------------------------------
float4 PSMain(PSIn i) : SV_Target
{
    float3 n = normalize(i.nrm);
    float3 tex = RockTex.Sample(LinearWrap, i.uv).rgb;

    // 2 つ目のテクスチャサンプル (異なるスケール) を掛けて繰り返し感を減らす
    float3 tex2 = RockTex.Sample(LinearWrap, i.uv * 0.23 + 0.31).rgb;
    tex = tex * (0.75 + 0.5 * tex2);

    // ランバート拡散反射: max(0, N・L)
    float diff = saturate(dot(n, LightDirW.xyz));

    // 半球ライティング風の環境光: 上を向いた面ほど明るい
    float ambient = 0.30 + 0.15 * saturate(n.y);

    float3 col = tex * (ambient + 0.75 * diff);

    // 谷底 (低い場所) を少し暗くしてくぼみを強調
    float depthShade = saturate((i.posW.y + 0.20 * i.posW.z + 3.0) / 10.0);   // 谷底で 0.3 付近、山で 1
    col *= lerp(0.80, 1.0, depthShade);

    return float4(col, 1.0);
}
